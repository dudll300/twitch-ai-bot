# Логин канала без # и ссылка на него: twitch.tv/ИМЯ_КАНАЛА
TWITCH_CHANNEL=
# Отдельный Twitch-аккаунт бота
TWITCH_BOT_NAME=
# Client ID приложения Twitch типа Public (не Client Secret)
TWITCH_CLIENT_ID=

# ai.starimg.ru: при необходимости уточните Base URL в личном кабинете
# Бот добавляет к Base URL путь /chat/completions
AI_BASE_URL=https://ai.starimg.ru/v1
AI_API_KEY=
# Можно выбрать основную модель из списка или указать свой ID
AI_MODEL=deepseek-v4.1-flash
