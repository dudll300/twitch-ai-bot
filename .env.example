# Логин канала без # и ссылка на него: twitch.tv/ИМЯ_КАНАЛА
TWITCH_CHANNEL=channel_name
# Отдельный Twitch-аккаунт бота
TWITCH_BOT_NAME=bot_name
# Client ID приложения Twitch типа Public (не Client Secret)
TWITCH_CLIENT_ID=YOUR_TWITCH_CLIENT_ID

# DeepSeek: https://api.deepseek.com
# ai.starimg.ru: точный Base URL смотрите в личном кабинете
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=YOUR_AI_API_KEY
# DeepSeek: deepseek-flash. Для ai.starimg.ru возьмите доступную текстовую модель из кабинета.
AI_MODEL=deepseek-flash
