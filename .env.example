# Логин канала или ссылка на Twitch
TWITCH_CHANNEL=
# Отдельный Twitch-аккаунт бота
TWITCH_BOT_NAME=
# Client ID приложения Twitch типа Public (не Client Secret)
TWITCH_CLIENT_ID=
# Название награды с обязательным вводом текста; регистр не важен
TWITCH_REWARD_TITLE="Вопрос ИИ"

# HTTPS Base URL API, совместимого с Chat Completions
# Пример провайдера; замените на адрес своего сервиса
AI_BASE_URL=https://ai.starimg.ru/v1
AI_API_KEY=
# ID модели должен быть доступен у выбранного провайдера
AI_MODEL=deepseek-v4.1-flash
# Запасные модели первого запуска; можно заменить или оставить пустым
AI_FALLBACK_MODELS=deepseek-v4-pro,deepseek-v4-flash

# Системный промпт хранится отдельно в prompt.txt и по умолчанию пуст
