# Логин канала без # и ссылка на него: twitch.tv/ИМЯ_КАНАЛА
TWITCH_CHANNEL=
# Отдельный Twitch-аккаунт бота
TWITCH_BOT_NAME=
# Client ID приложения Twitch типа Public (не Client Secret)
TWITCH_CLIENT_ID=

# ai.starimg.ru: точный Base URL и ID текстовой модели смотрите в личном кабинете
# Бот добавляет к Base URL путь /chat/completions
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
