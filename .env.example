# Логин канала или ссылка на Twitch
TWITCH_CHANNEL=
# Отдельный Twitch-аккаунт бота
TWITCH_BOT_NAME=
# Client ID приложения Twitch типа Public (не Client Secret)
TWITCH_CLIENT_ID=
# Название награды с обязательным вводом текста; регистр не важен
TWITCH_REWARD_TITLE="Вопрос ИИ"

# Явный выбор: compatible или openai. Префикс ключа не определяет провайдера.
AI_PROVIDER=compatible
# HTTPS Base URL совместимого Chat Completions API
# Пример провайдера; замените на адрес своего сервиса
AI_BASE_URL=https://ai.starimg.ru/v1
AI_API_KEY=
# ID модели должен быть доступен у выбранного провайдера
AI_MODEL=deepseek-v4.1-flash
# Запасные модели первого запуска; можно заменить или оставить пустым
AI_FALLBACK_MODELS=deepseek-v4-pro,deepseek-v4-flash

# Отдельный профиль официального OpenAI. Для него адрес фиксирован:
# https://api.openai.com/v1 — AI_BASE_URL выше на OpenAI не влияет.
# Чтобы включить его, задайте AI_PROVIDER=openai и свой ключ здесь.
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4.1-mini
AI_OPENAI_FALLBACK_MODELS=
AI_OPENAI_PROMPT_MODEL=gpt-4.1-mini

# При сохранении приложение добавляет AI_COMPATIBLE_* и AI_OPENAI_*.
# Они раздельно сохраняют ключ, адрес и модели обоих подключений.
# Старый файл без AI_PROVIDER остаётся совместимым подключением.

# Системный промпт хранится отдельно в prompt.txt и по умолчанию пуст
